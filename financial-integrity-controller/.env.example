# Copy this file to `.env` and fill in whichever provider you're using
# (see LLM_PROVIDER in src/config.py -- only ONE of these is needed).
# Never commit the real `.env` file to git -- it's already in .gitignore.
#
# This is ONLY needed for the optional LLM investigation assistant in the
# dashboard's Investigation tab. Everything else in this project (data
# generation, reconciliation, anomaly detection, risk scoring, the rest of
# the dashboard) works with zero API key and zero cost.

# --- Ollama (default, $0 forever) ---
# No key needed at all! Just run `ollama serve` on the same machine.
# Nothing to put here for this option.

# --- Groq (free tier, hosted -- good if deploying online) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-key-here

# --- Gemini (free tier, hosted) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# --- Anthropic (small free trial credit, then paid) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key-here
